# Supabase dashboard > Connect > Session pooler (port 5432, IPv4 compatible).
# Replace placeholders and URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require"

# Optional migration connection; omit to reuse DATABASE_URL.
# MIGRATION_DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require"

CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Local HTTP defaults. For HTTPS use SECURE=true; cross-site HTTPS also needs SAMESITE=none.
SESSION_COOKIE_NAME=buyora_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_SECONDS=604800

# Optional private Storage bucket for product photos; backend secrets only.
# Leave these unset until configured with real project values.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=YOUR_BACKEND_ONLY_SECRET_KEY
# SUPABASE_STORAGE_BUCKET=YOUR_PRIVATE_BUCKET
