# JSON array. Set to your frontend origin when deploying.
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
dugenmorphix
# Cookie settings: set SECURE=true for HTTPS. Cross-site HTTPS deployments also
# require SAMESITE=none; keep CORS_ORIGINS limited to trusted frontend origins.
SESSION_COOKIE_NAME=
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=
SESSION_LIFETIME_SECONDS=

