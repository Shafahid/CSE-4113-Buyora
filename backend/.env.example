# Supabase dashboard > Connect > Session pooler (port 5432, IPv4 compatible).
# Replace placeholders and URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require"

# Optional AI admission limits shared per seller across image, market and platform jobs.
PHASE2_AI_REQUESTS_PER_MINUTE=10
PHASE2_AI_DAILY_TOKEN_BUDGET=250000
PHASE2_AI_MAX_INPUT_TOKENS=16384
PHASE2_AI_MAX_OUTPUT_TOKENS=4096
PHASE2_AI_TIMEOUT_SECONDS=90

# Optional migration connection; omit to reuse DATABASE_URL.
# MIGRATION_DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require"

CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Local HTTP defaults. For HTTPS use SECURE=true; cross-site HTTPS also needs SAMESITE=none.
SESSION_COOKIE_NAME=buyora_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_SECONDS=604800

# Optional private Storage bucket for product photos; backend secrets only.
# Leave these unset until configured with real project values.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=YOUR_BACKEND_ONLY_SECRET_KEY
# SUPABASE_STORAGE_BUCKET=YOUR_PRIVATE_BUCKET

# Simulation model connection (backend only).
# TOKEN_BD_API_URL=https://YOUR_MODEL_ENDPOINT/v1
# TOKEN_BD_API_KEY=YOUR_MODEL_API_KEY
# TOKEN_BD_MODEL=YOUR_MODEL_NAME
# Output budget includes any reasoning tokens charged by the provider.
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_SECONDS=90

# Use labeled rule-based assessments after model errors or spending limits.
LLM_FALLBACK_ENABLED=true
# Conservative per-run dispatch and reserved-token limits (including retries).
SIMULATION_MAX_MODEL_CALLS=66
SIMULATION_TOKEN_BUDGET=200000
SIMULATION_MAX_PERSONAS=30
SIMULATION_CONCURRENCY=3
# Set false in the API process when running `uv run python worker.py` separately.
SIMULATION_WORKER_ENABLED=true
