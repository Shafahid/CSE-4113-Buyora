{
  "$defs": {
    "EvidenceSnapshot": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "product_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Product Id"
        },
        "competitor_name": {
          "title": "Competitor Name",
          "type": "string"
        },
        "product_name": {
          "title": "Product Name",
          "type": "string"
        },
        "competitor_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Competitor Description"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "offer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Offer"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Platform"
        },
        "observed_at": {
          "format": "date",
          "title": "Observed At",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Note"
        }
      },
      "required": [
        "id",
        "product_id",
        "competitor_name",
        "product_name",
        "competitor_description",
        "category",
        "price",
        "currency",
        "offer",
        "platform",
        "observed_at",
        "notes"
      ],
      "title": "EvidenceSnapshot",
      "type": "object"
    },
    "ExecutionBudget": {
      "additionalProperties": false,
      "properties": {
        "max_input_tokens": {
          "default": 16384,
          "minimum": 1,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 4096,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_attempts": {
          "const": 1,
          "default": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 90,
          "maximum": 180,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "ExecutionBudget",
      "type": "object"
    },
    "ProductSnapshot": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Price"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "features": {
          "items": {
            "type": "string"
          },
          "title": "Features",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "price",
        "currency",
        "description",
        "features"
      ],
      "title": "ProductSnapshot",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "product": {
      "$ref": "#/$defs/ProductSnapshot"
    },
    "competitors": {
      "items": {
        "$ref": "#/$defs/EvidenceSnapshot"
      },
      "maxItems": 20,
      "title": "Competitors",
      "type": "array"
    },
    "language": {
      "enum": [
        "en",
        "bn"
      ],
      "title": "Language",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/ExecutionBudget"
    },
    "comparison_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comparison Date"
    },
    "max_evidence_age_days": {
      "default": 90,
      "maximum": 365,
      "minimum": 1,
      "title": "Max Evidence Age Days",
      "type": "integer"
    }
  },
  "required": [
    "product",
    "language"
  ],
  "title": "MarketInput",
  "type": "object"
}
