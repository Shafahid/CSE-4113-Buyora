{
  "$defs": {
    "AIMetadata": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "ai",
            "fallback",
            "unavailable"
          ],
          "title": "Source",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "input_token_bound": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Token Bound"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source",
        "prompt_version",
        "evaluated_at"
      ],
      "title": "AIMetadata",
      "type": "object"
    },
    "ImageFinding": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "enum": [
            "good",
            "needs_improvement",
            "not_applicable",
            "uncertain"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "feedback": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Feedback"
        },
        "severity": {
          "default": "uncertain",
          "enum": [
            "none",
            "minor",
            "major",
            "uncertain"
          ],
          "title": "Severity",
          "type": "string"
        },
        "observation": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation"
        }
      },
      "required": [
        "assessment",
        "feedback"
      ],
      "title": "ImageFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "clarity": {
      "$ref": "#/$defs/ImageFinding"
    },
    "lighting": {
      "$ref": "#/$defs/ImageFinding"
    },
    "composition": {
      "$ref": "#/$defs/ImageFinding"
    },
    "background": {
      "$ref": "#/$defs/ImageFinding"
    },
    "text_readability": {
      "$ref": "#/$defs/ImageFinding"
    },
    "product_consistency": {
      "$ref": "#/$defs/ImageFinding"
    },
    "suggestions": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Suggestions",
      "type": "array"
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/AIMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "clarity",
    "lighting",
    "composition",
    "background",
    "text_readability",
    "product_consistency",
    "suggestions"
  ],
  "title": "ImageAnalysisResult",
  "type": "object"
}
