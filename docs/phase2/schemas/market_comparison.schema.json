{
  "$defs": {
    "AIMetadata": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "ai",
            "fallback",
            "unavailable"
          ],
          "title": "Source",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "input_token_bound": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Token Bound"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source",
        "prompt_version",
        "evaluated_at"
      ],
      "title": "AIMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "feature_comparison": {
      "maxLength": 3000,
      "minLength": 1,
      "title": "Feature Comparison",
      "type": "string"
    },
    "offer_comparison": {
      "maxLength": 3000,
      "minLength": 1,
      "title": "Offer Comparison",
      "type": "string"
    },
    "competitive_strengths": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Competitive Strengths",
      "type": "array"
    },
    "competitive_weaknesses": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Competitive Weaknesses",
      "type": "array"
    },
    "marketing_recommendations": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Marketing Recommendations",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "data_status": {
      "default": "sufficient_data",
      "enum": [
        "sufficient_data",
        "insufficient_data"
      ],
      "title": "Data Status",
      "type": "string"
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/AIMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "feature_comparison",
    "offer_comparison",
    "competitive_strengths",
    "competitive_weaknesses",
    "marketing_recommendations",
    "limitations"
  ],
  "title": "MarketResult",
  "type": "object"
}
