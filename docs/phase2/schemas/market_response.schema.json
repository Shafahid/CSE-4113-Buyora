{
  "$defs": {
    "EvidenceSnapshot": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "product_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Product Id"
        },
        "competitor_name": {
          "title": "Competitor Name",
          "type": "string"
        },
        "product_name": {
          "title": "Product Name",
          "type": "string"
        },
        "competitor_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Competitor Description"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "offer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Offer"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Platform"
        },
        "observed_at": {
          "format": "date",
          "title": "Observed At",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Note"
        }
      },
      "required": [
        "id",
        "product_id",
        "competitor_name",
        "product_name",
        "competitor_description",
        "category",
        "price",
        "currency",
        "offer",
        "platform",
        "observed_at",
        "notes"
      ],
      "title": "EvidenceSnapshot",
      "type": "object"
    },
    "ExecutionBudget": {
      "additionalProperties": false,
      "properties": {
        "max_input_tokens": {
          "default": 16384,
          "minimum": 1,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 4096,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_attempts": {
          "const": 1,
          "default": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 90,
          "maximum": 180,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "ExecutionBudget",
      "type": "object"
    },
    "MarketInput": {
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "product": {
          "$ref": "#/$defs/ProductSnapshot"
        },
        "competitors": {
          "items": {
            "$ref": "#/$defs/EvidenceSnapshot"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Competitors",
          "type": "array"
        },
        "language": {
          "enum": [
            "en",
            "bn"
          ],
          "title": "Language",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/ExecutionBudget"
        }
      },
      "required": [
        "product",
        "competitors",
        "language"
      ],
      "title": "MarketInput",
      "type": "object"
    },
    "MarketResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "feature_comparison": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Feature Comparison",
          "type": "string"
        },
        "offer_comparison": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Offer Comparison",
          "type": "string"
        },
        "competitive_strengths": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Competitive Strengths",
          "type": "array"
        },
        "competitive_weaknesses": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Competitive Weaknesses",
          "type": "array"
        },
        "marketing_recommendations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Marketing Recommendations",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "feature_comparison",
        "offer_comparison",
        "competitive_strengths",
        "competitive_weaknesses",
        "marketing_recommendations",
        "limitations"
      ],
      "title": "MarketResult",
      "type": "object"
    },
    "ProductSnapshot": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Price"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "features": {
          "items": {
            "type": "string"
          },
          "title": "Features",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "price",
        "currency",
        "description",
        "features"
      ],
      "title": "ProductSnapshot",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "integer"
    },
    "product_id": {
      "title": "Product Id",
      "type": "integer"
    },
    "status": {
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "language": {
      "enum": [
        "en",
        "bn"
      ],
      "title": "Language",
      "type": "string"
    },
    "input_snapshot": {
      "$ref": "#/$defs/MarketInput"
    },
    "analysis_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/MarketResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Message"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completed At"
    },
    "price_observations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Price Observations",
      "type": "array"
    },
    "evidence_notice": {
      "default": "Competitor information is seller-provided and not independently verified.",
      "title": "Evidence Notice",
      "type": "string"
    },
    "interpretations_require_review": {
      "default": true,
      "title": "Interpretations Require Review",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "product_id",
    "status",
    "language",
    "input_snapshot",
    "analysis_result",
    "error_message",
    "created_at",
    "updated_at",
    "completed_at",
    "price_observations"
  ],
  "title": "MarketResponse",
  "type": "object"
}
